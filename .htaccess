RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Keep the lead log and dotfiles private
<FilesMatch "^(leads\.log|\..*)$">
  Require all denied
</FilesMatch>

Options -Indexes

# Keep CSS/JS from being cached for long, so changes show up quickly
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>
